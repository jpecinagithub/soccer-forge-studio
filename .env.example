# Soccer Forge Studio — ejemplo. Copiar a .env SOLO en el servidor Oracle.
# Nunca commitear .env ni ninguna clave. Ver docs/DEPLOYMENT.md §5.
NODE_ENV=production
PORT=4300
DATABASE_URL=postgres://soccer:CHANGEME@postgres:5432/soccer
REDIS_URL=redis://redis:6379
POSTGRES_PASSWORD=CHANGEME
STORAGE_PATH=/data/media
PUBLIC_BASE_URL=https://jpecina.duckdns.org/soccer
# Muse Spark 1.3 — PENDIENTE de confirmar en Fase 1 (proveedor, endpoint, coste):
MUSE_SPARK_API_KEY=
MUSE_SPARK_MODEL=muse-spark-1.3
MUSE_SPARK_BASE_URL=
